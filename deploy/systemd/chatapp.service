[Unit]
Description=Viikko 5 LLM Chat Application
After=network.target mysql.service ollama.service
Wants=mysql.service ollama.service

[Service]
Type=simple
User=chatapp
Group=www-data
WorkingDirectory=/opt/chatapp/app
EnvironmentFile=/etc/chatapp/chatapp.env
RuntimeDirectory=chatapp
RuntimeDirectoryMode=0750
UMask=0007

ExecStart=/opt/chatapp/venv/bin/gunicorn \
    --workers 2 \
    --bind unix:/run/chatapp/gunicorn.sock \
    --umask 007 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

